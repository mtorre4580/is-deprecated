{
  "name": "@mtorre4580/is-deprecated",
  "version": "1.0.1",
  "description": "Deprecate functions, methods, properties and classes with runtime deprecation warnings. Node + browser, TypeScript, decorators. A modern depd / util.deprecate alternative.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtorre4580/is-deprecated.git"
  },
  "homepage": "https://github.com/mtorre4580/is-deprecated#readme",
  "bugs": {
    "url": "https://github.com/mtorre4580/is-deprecated/issues"
  },
  "keywords": [
    "deprecate",
    "deprecated",
    "deprecation",
    "deprecation-warning",
    "deprecate-function",
    "deprecate-method",
    "deprecate-property",
    "deprecated-decorator",
    "decorator",
    "typescript",
    "depd",
    "util-deprecate",
    "util.deprecate",
    "emitWarning",
    "obsolete",
    "warning",
    "browser",
    "isomorphic",
    "esm",
    "api-versioning"
  ],
  "author": "mtorre4580",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:package",
    "update-changelog": "git fetch && auto-changelog"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "auto-changelog": "^2.5.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "size-limit": [
    {
      "name": "full bundle (ESM, gzip)",
      "path": "dist/index.js",
      "limit": "2.5 kB"
    },
    {
      "name": "deprecate() only",
      "path": "dist/index.js",
      "import": "{ deprecate }",
      "limit": "1.5 kB"
    }
  ],
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "update-changelog.hbs",
    "unreleased": false,
    "commitLimit": false,
    "startingVersion": "0.0.1",
    "sortCommits": "date-desc",
    "hideEmptyReleases": true
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
